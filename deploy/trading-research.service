[Unit]
Description=Bounded paper research and simulation risk guardian
After=network-online.target docker.service

[Service]
Type=oneshot
User=root
WorkingDirectory=/home/ubuntu/ai-trading-supervisor
ExecStartPre=/usr/bin/python3 scripts/collect_equity_paper.py
ExecStart=/usr/bin/python3 -m research_lab.worker
TimeoutStartSec=180
CPUQuota=25%
MemoryMax=256M
TasksMax=24
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/home/ubuntu/ai-trading-supervisor/research_state /home/ubuntu/ai-trading-supervisor/user_data/reports
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077
